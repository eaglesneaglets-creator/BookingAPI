# Booking API — environment. Names only; real values live on Railway.
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=
# Postgres only (the no-double-booking guarantee is a Postgres constraint).
# On Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=
ALLOWED_HOSTS=booking-api-production.up.railway.app
CSRF_TRUSTED_ORIGINS=https://booking-api-production.up.railway.app
# A private path for the admin, not "admin/".
ADMIN_URL=
# Fernet key(s) encrypting each platform's webhook secret. First one encrypts.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BOOKING_SECRET_KEYS=
# On Railway: ${{Redis.REDIS_URL}}. Without it webhooks send inline and holds
# expire only when someone else asks for their time.
REDIS_URL=
# Optional
HOLD_DEFAULT_MINUTES=15
HOLD_MAX_MINUTES=10080
AVAILABILITY_MAX_DAYS=62
LOG_LEVEL=INFO
# Worker only: exactly one worker runs the schedule (hold expiry every minute).
CELERY_BEAT=1
